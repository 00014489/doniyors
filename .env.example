# Production settings. Copy to .env next to docker-compose.yml, fill in every
# empty value, then run:  docker compose up -d --build
#
# Never commit the filled-in file. For the generated secrets use
#   openssl rand -hex 32
# which gives letters and digits only — "$", ";" and quotes break values here.


# ---- Site ------------------------------------------------------------------

# Domain the Mini App is served from, without https://, e.g. app.example.com.
# Before the first start its DNS A record must point at this server, and ports
# 80 and 443 must be open — Let's Encrypt checks both.
DOMAIN=

# Let's Encrypt sends certificate expiry notices here.
LETSENCRYPT_EMAIL=

# 1 = Let's Encrypt's staging CA: untrusted certificates but generous rate
# limits, for rehearsing on a new server. Leave 0 in production.
LETSENCRYPT_STAGING=0

# Time zone for logs and for the dates the bot shows.
TZ=Asia/Tashkent


# ---- PostgreSQL ------------------------------------------------------------

POSTGRES_DB=MainDb
POSTGRES_USER=postgres

# Letters and digits only: it is placed into a connection string.
# Read only when the database volume is first created — changing it later does
# not change the password inside the database (see DEPLOY.md).
POSTGRES_PASSWORD=


# ---- API authentication ----------------------------------------------------

# At least 32 characters, or the API refuses to start.
JWT_KEY=
JWT_ISSUER=MiniApp
JWT_AUDIENCE=MiniApp
JWT_EXPIRES_MINUTES=60


# ---- Telegram --------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram sends it back on every webhook call and the bot rejects calls
# without it. Letters, digits, "_" and "-" only.
TELEGRAM_WEBHOOK_SECRET=

# Label of the bot's menu button that opens the Mini App, for people who have
# not chosen a language yet. Everyone else sees it in their own language.
# Keep the quotes around any value containing spaces.
MINI_APP_BUTTON_TEXT="Open app"
